{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-03",
  "vars": {
    "TURNSTILE_HOSTNAMES": "jshmlnd.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
